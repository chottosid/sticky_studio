# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database?sslmode=require

# Authentication
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=admin123

# Environment
NODE_ENV=development

# OpenRouter API (for AI features)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: App URL for OpenRouter headers
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (SMTP) for deadline reminders
# For Gmail, use an App Password (not your regular password):
# 1. Enable 2FA on Google Account
# 2. Go to Account Settings → Security → App Passwords
# 3. Generate a new app password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# Cron Job Security (for production)
# Generate a secure random string for authenticating cron requests
CRON_SECRET=your-secure-random-string
