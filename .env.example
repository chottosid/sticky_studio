# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database
# For hosted Supabase, set this to the project CA PEM, or use .local/supabase-postgres-ca.crt.
DATABASE_CA_CERT=
# Optional override for the local, column-scoped research login. See AGENTS.md.
STICKY_RESEARCH_DATABASE_URL=

# Authentication
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=admin123
# Use a long, random value in production. Existing APP_USER_PASSWORD is only a fallback.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Environment
NODE_ENV=development
APP_TIMEZONE=Asia/Dhaka

# Public URL for Telegram reminder links (optional on Vercel)
NEXT_PUBLIC_BASE_URL=http://localhost:9002

# OpenRouter API (primary AI model)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional model overrides
OPENROUTER_MODEL=openai/gpt-6-luna-pro

# Optional agent research and drafting. Use a separate OpenRouter key with a monthly credit limit.
OPENROUTER_AGENT_API_KEY=
OPENROUTER_AGENT_MODEL=google/gemini-2.5-flash-lite

# Private Supabase Storage (server only; never expose the service-role key to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Job Security (for production)
# Generate a secure random string for authenticating cron requests
CRON_SECRET=your-secure-random-string

# Telegram bot (optional): opportunity intake and private deadline reminders
# Create the bot with @BotFather and disable privacy mode (/setprivacy -> Disable).
TELEGRAM_BOT_TOKEN=123456:your-bot-token
# Random string of A-Z, a-z, 0-9, _ or - (e.g. `openssl rand -hex 32`)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Your numeric Telegram user ID. Start a private chat with the bot to receive reminders.
TELEGRAM_OWNER_ID=123456789
